{
  "name": "Python Seminar",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Karel window",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash .devcontainer/launch-karel.sh",
  "customizations": {
  "codespaces": {
    "openFiles": [
      "01-karel-the-robot/student.py",
      "01-karel-the-robot/run_world.py"
    ]
  },
  "vscode": {
    "settings": {
      "python.defaultInterpreterPath": "/usr/bin/python3",
    },
    "extensions": ["ms-python.python"]
  }
}
}
